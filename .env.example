# Simulator (see Fuel_Supply_Simulator_Integration_Guide.md)
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
SIMULATOR_PORT=8000

# Postgres
POSTGRES_USER=fuelsupply
POSTGRES_PASSWORD=fuelsupply
POSTGRES_DB=fuelsupply
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Core service
CORE_PORT=8100

# Intelligence service
INTELLIGENCE_PORT=8200
# Never commit a real key. Leave blank to force templated-narration fallback (ADR-005).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Frontend
FRONTEND_PORT=5173
VITE_CORE_BASE_URL=http://localhost:8100

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
