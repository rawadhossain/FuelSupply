# Simulator (see Fuel_Supply_Simulator_Integration_Guide.md)
# Demo default: 1 tick ~= 1 wall-clock second, easier to narrate live. Was 8.
SIMULATION_SPEED=1
TICK_MINUTES=15
SIMULATOR_START_MODE=paused
SIMULATOR_PORT=8000
# Where core reaches the simulator (compose-internal DNS name; change only to point at an external simulator)
SIMULATOR_BASE_URL=http://simulator-api:8000

# Postgres
POSTGRES_USER=fuelsupply
POSTGRES_PASSWORD=fuelsupply
POSTGRES_DB=fuelsupply
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
# Where core reaches redis
REDIS_URL=redis://redis:6379/0

# Core service
CORE_PORT=8100
# Where core reaches the intelligence service
INTELLIGENCE_BASE_URL=http://intelligence:8200

# Intelligence service
INTELLIGENCE_PORT=8200
# Never commit a real key. Leave blank to force templated-narration fallback (ADR-005).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Frontend
# Host port for the nginx-served UI (container listens on 8080)
FRONTEND_PORT=8080
# Where nginx proxies /api/ and /ws to. No trailing slash or path.
CORE_UPSTREAM=http://core:8100
# Frontend code must use relative URLs; see docs/frontend-api-contract.md

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Anonymous users get Viewer only; change this before exposing Grafana beyond localhost
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
ALLOY_PORT=12345
# 8081, not 8080: avoids clashing with the frontend/cadvisor's own internal 8080
CADVISOR_PORT=8081
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
SIM_EXPORTER_PORT=9101

# Build metadata (CI sets this to the commit SHA; baked into images as ENV GIT_SHA)
GIT_SHA=dev
