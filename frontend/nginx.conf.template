# Rendered by the nginx entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Substituted: ${CORE_UPSTREAM} (e.g. http://core:8100, no trailing slash/path),
# ${NGINX_LOCAL_RESOLVERS} (Docker's embedded DNS, exported by the image's
# 15-local-resolvers.envsh when NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve core at request time (short TTL) instead of caching its IP
    # for the nginx process lifetime, so a recreated core container (new IP)
    # doesn't need a frontend restart. $core_upstream in a variable forces
    # nginx to use the resolver instead of resolving once at config load.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    set $core_upstream "${CORE_UPSTREAM}";

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # REST: /api/foo -> ${CORE_UPSTREAM}/foo (prefix stripped)
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SSE-style streams under /api/: no buffering, long-lived reads.
    location ~ ^/api/(?:.*/)?(?:stream|events)$ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # WebSocket: /ws is passed through unchanged (core serves /ws).
    location /ws {
        proxy_pass $core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Vite emits content-hashed files under /assets/: safe to cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html must always be revalidated so new deploys are picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
