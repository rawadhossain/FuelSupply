    {
      "id": 11,
      "type": "timeseries",
      "title": "Decisions by policy/outcome",
      "description": "Decision throughput, split by which policy ran and what it decided.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy, outcome) (rate(decisions_total[1m])) * 60",
          "refId": "A",
          "format": "time_series",
          "legendFormat": "{{policy}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
