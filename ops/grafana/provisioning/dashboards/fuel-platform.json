      "title": "Prediction confidence",
      "description": "Model confidence: average and p95.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(rate(intel_model_confidence_sum[5m])) / avg(rate(intel_model_confidence_count[5m]))",
