          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Event"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ID"
